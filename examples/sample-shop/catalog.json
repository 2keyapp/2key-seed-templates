{
	"$schema": "../../schemas/catalog.schema.json",
	"schemaVersion": 1,
	"surfaces": ["secmail", "office"],
	"platforms": ["linux"],
	"hosts": {
		"secmailDesktop": {
			"surfaces": ["secmail"],
			"excludePlatforms": ["linux"]
		},
		"secmailLinux": {
			"surfaces": ["secmail"]
		},
		"office": {
			"surfaces": ["office"],
			"excludePlatforms": ["linux"]
		}
	},
	"products": {
		"SecMail": {
			"description": "Scomm Email and Office add-ons",
			"isActive": true,
			"meters": {
				"scomm.ai.tokens": {
					"displayName": "Scomm AI tokens",
					"unit": "token",
					"aggregation": "sum"
				}
			},
			"offerings": {
				"pgp": {
					"displayName": "Outlook OpenPGP ECC",
					"resources": {
						"addonCode": "pgp",
						"surfaces": ["office"]
					}
				},
				"pqc": {
					"displayName": "Outlook OpenPGP ECC+PQC",
					"resources": {
						"addonCode": "pqc",
						"surfaces": ["secmail", "office"]
					}
				},
				"linux": {
					"displayName": "Linux Version",
					"resources": {
						"addonCode": "linux",
