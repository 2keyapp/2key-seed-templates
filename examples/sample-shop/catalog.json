				"Outlook OpenPGP ECC+PQC": {
					"offeringCodes": ["pqc"],
					"pricings": {
						"annual": {
							"currency": "USD",
							"basePrice": 15
						}
					}
				},
				"Linux Version": {
					"offeringCodes": ["linux"],
					"pricings": {
						"annual": {
							"currency": "USD",
							"basePrice": 5
						}
					}
				},
				"Local-AI": {
					"offeringCodes": ["ai_assistant"],
					"pricings": {
						"annual": {
							"currency": "USD",
							"basePrice": 5
						}
					}
				}
			}
		}
